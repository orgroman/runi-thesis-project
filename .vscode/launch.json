    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.secrets.env"
        },
        {
            "name": "cli - remove dependent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "console": "integratedTerminal",
            "env": {
                "CONFIG_DIR": "${workspaceFolder}/configs",
            },
            "args": [
                // "train_model",
                // "--train_input", "train.tsv",
                "run_negation_detection_model",
                "--input_tsv",
                "C:\\workspace_or_private\\repos\\runi-thesis-project\\hidrive\\patentmatch_test\\patentmatch_test.tsv",
                "--column",
                "text_b",
            ]
        },
        {
            "name": "cli - create jsonl",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli.py",
            "console": "integratedTerminal",
            "env": {
                "CONFIG_DIR": "${workspaceFolder}/configs",
            },
            "args": [
                // "train_model",
                // "--train_input", "train.tsv",
                "prepare_jsonl_column",
                "--input_tsv",
                "C:\\workspace_or_private\\repos\\runi-thesis-project\\hidrive\\patentmatch_test\\patentmatch_test_no_claims.csv",
                "--column",
                "text",
            ]
        },
        {
            "name": "Debug - file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        },
        {
            "name": "debug aiopika df",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/runi_thesis_project/clients/aiopika_df.py"
        },
        {
            "name": "Temporal: Worker",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/worker.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.secrets.env",
            "justMyCode": false
        },
        {
            "name": "Temporal: Start Workflow",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/starter.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.secrets.env",
            "args": [
                "--batch-size", "1000"
            ],
            "justMyCode": false
        },
        {
            "name": "Temporal: Debug Status",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.secrets.env",
            "args": ["check"],
            "justMyCode": false
        },
        {
            "name": "Temporal: Debug Worker",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.secrets.env",
            "args": ["worker"],
            "justMyCode": false
        },
        {
            "name": "Temporal: Complete Workflow",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_all.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.secrets.env",
            "args": [
                "--csv", "C:\\Users\\orgrd\\workspace\\data\\patentmatch_test\\patentmatch_test_no_claims.csv",
                "--batch-size", "1000" 
            ],
            "justMyCode": false
        }
